  "actions": [
    {
      "id": "switch-world",
      "type": "custom",
      "purpose": "Switch the room world while preserving inspection angle; cancel any active message.",
      "payload": {
        "operation": "world",
        "transitionIds": [
          "enter-other-side",
          "return-home"
        ],
        "targetStates": [
          "hawkins",
          "upside-down"
        ],
        "nativeStates": [
          "normal",
          "alternate"
        ]
      }
    },
    {
      "id": "play-run",
      "type": "custom",
      "purpose": "Receive the three-letter clue on the 3D wall; replay without revealing it as 2D text.",
      "payload": {
        "operation": "sequence",
        "configNodeId": "scene",
        "configPath": "signal",
        "playingText": "Sending RUN…",
        "completedText": "MESSAGE RECEIVED / RUN",
        "readyText": "ALPHABET LINK / STANDBY",
        "playingStatus": "Watch the alphabet wall.",
        "playLabel": "Sending…",
        "idleLabel": "Send RUN"
      }
    },
    {
      "id": "toggle-rotation",
      "type": "toggle",
      "purpose": "Turn the miniature slowly or freeze it without moving the camera.",
      "binding": "rotating",
      "payload": {
        "labels": {
          "true": "Pause motion",
          "false": "Inspect motion"
        }
      }
    },
    {
      "id": "reset-scene",
      "type": "custom",
      "purpose": "Cancel signal; restore Hawkins, angle zero, and paused motion. Nothing is deleted.",
      "payload": {
        "operation": "reset",
        "targetStateId": "hawkins",
        "transitionId": "reset-home"
      }
    },
    {
      "id": "enter-n",
      "type": "custom",
      "purpose": "Append a reply letter after hearing the message.",
      "payload": {
        "operation": "reply-letter",
        "letter": "N"
      }
    },
    {
      "id": "enter-a",
      "type": "custom",
      "purpose": "Append a reply letter after hearing the message.",
      "payload": {
        "operation": "reply-letter",
        "letter": "A"
      }
    },
    {
      "id": "enter-r",
      "type": "custom",
      "purpose": "Append a reply letter after hearing the message.",
      "payload": {
        "operation": "reply-letter",
        "letter": "R"
      }
    },
    {
      "id": "enter-s",
      "type": "custom",
      "purpose": "Append a reply letter after hearing the message.",
      "payload": {
        "operation": "reply-letter",
        "letter": "S"
      }
    },
    {
      "id": "enter-u",
      "type": "custom",
      "purpose": "Append a reply letter after hearing the message.",
      "payload": {
        "operation": "reply-letter",
        "letter": "U"
      }
    },
    {
      "id": "enter-o",
      "type": "custom",
      "purpose": "Append a reply letter after hearing the message.",
      "payload": {
        "operation": "reply-letter",
        "letter": "O"
      }
    },
    {
      "id": "tune-frequency",
      "type": "custom",
      "purpose": "Find the signal; brightness and receiver strength respond together.",
      "payload": {
        "operation": "tune-frequency"
      }
    },
    {
      "id": "erase-reply",
      "type": "custom",
      "purpose": "Remove the last reply letter.",
      "payload": {
        "operation": "erase-reply"
      }
    },
    {
      "id": "submit-reply",
      "type": "custom",
      "purpose": "Check the observed sequence; correct reply lights the wall and restores Hawkins.",
      "payload": {
        "operation": "submit-reply"
      }
    }
  ],
